{
  "name": "dsh-git-rescue",
  "version": "1.8.0",
  "description": "DSH git 版本管理 + 崩溃自动救援：.dsh 与 workspace 纳入 git，自动 commit、GitHub token 远端备份（REST API 降级）、崩溃自动回退、自动更新（强制跟随 GitHub 最新稳定版，环境变量 DSH_GIT_RESCUE_AUTO_UPDATE=0 可关）、接管式重启（独立脚本重启+验证，规避会话中断）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "engines": {
    "dsh": ">=0.0.1",
    "node": ">=20.0.0"
  },
  "dsh": {
    "runtime": "host",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "skills": [
      "./skills/dsh-git-rescue.md",
      "./skills/dsh-deployment-overview.md",
      "./skills/dsh-test-env.md",
      "./skills/dsh-blue-green-deploy.md",
      "./skills/dsh-clean-env.md"
    ],
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "guardian"
  ],
  "license": "MIT"
}
