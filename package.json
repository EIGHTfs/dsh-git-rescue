{
  "name": "dsh-git-rescue",
  "version": "2.1.0",
  "description": "DSH 救援恢复插件（2.1.0 合并版：以 2.0.0 重构为基底，合并 v1.13.0 独有功能——救援积分/沙盒检测/会话恢复联动/测试环境保护）：守护进程 + .dsh git 仓库管理 + 远端私有库备份（token/SSH 双方案）+ 开机自启 + 救援环境 + 专项恢复工具 + git 还原 + 纯净 dsh 协助兜底 + 版本自动更新（大版本/结构不一致走卸载重装）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "dsh": ">=0.0.1",
    "node": ">=20.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "skills": [
      "./skills/dsh-git-rescue.md",
      "./skills/dsh-boot-troubleshooting.md",
      "./skills/dsh-clean-env.md",
      "./skills/dsh-test-env.md",
      "./skills/rescue-env-write-rule.md",
      "./skills/dsh-git-rescue-refactor-requirements.md",
      "./skills/dsh-git-rescue-codelevel-repair.md",
      "./skills/dsh-dir-tree.md"
    ]
  },
  "files": [
    "lib",
    "guardian",
    "cordis.patch.yml",
    "skills"
  ],
  "license": "MIT"
}